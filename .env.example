# Copy to .env for local use. Never commit .env. Never put wallet passwords or keys in files.
#
# Consensus parameters (reward, supply cap, fees, difficulty, genesis) are NOT configurable
# here on purpose: they are fixed per network profile in mineai/config.py.

# Network profile: devnet | testnet   (mainnet is intentionally disabled)
MINEAI_NETWORK=devnet

# API bind address. Keep 127.0.0.1 unless you understand the exposure.
MINEAI_HOST=127.0.0.1
MINEAI_PORT=8080

# Data directory (a per-network sub-folder is created inside it).
# Default: ~/.mineai
# MINEAI_DATA_DIR=

# API safety limits
MINEAI_MAX_BODY_BYTES=65536
MINEAI_RATE_LIMIT_PER_MINUTE=240

# Log level: DEBUG | INFO | WARNING | ERROR
MINEAI_LOG_LEVEL=INFO

# ---- P2P (Milestone 3) ----
# Set to 0 to run a node without peer-to-peer networking.
MINEAI_P2P=1
# P2P listen address. Keep 127.0.0.1: the P2P layer is unencrypted and unauthenticated.
MINEAI_P2P_HOST=127.0.0.1
# P2P port (default: profile default, devnet 8081)
# MINEAI_P2P_PORT=
# Comma-separated seed peers, host:port
# MINEAI_SEEDS=127.0.0.1:8081
MINEAI_MAX_PEERS=16
